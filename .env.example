# Feature toggles
LIVE_OBSERVATIONS_ENABLED=true
LIVE_FORECASTS_ENABLED=true
# Collect followed locations every 3 hours (plus processing time).
REFRESH_INTERVAL_SECONDS=10800
# Shared pause between uncached Open-Meteo requests, including manual forecasts.
OPENMETEO_MIN_INTERVAL_SECONDS=5
REQUEST_TIMEOUT_SECONDS=8
# Persist observations, forecast history, saved locations and prepared results.
DATABASE_URL=
# Keep true for a single always-running web process. Set false on web processes
# when running the separate collector with: python -m app.worker
BACKGROUND_REFRESH_ENABLED=true

# Dublin Bay hourly buoy wind observations (public read-only API, no signup).
DUBLIN_BAY_BUOY_ENABLED=true
DUBLIN_BAY_API_URL=https://api.dublinbaybuoy.com/rest/v1
# Optional override if the provider rotates its documented publishable key.
# DUBLIN_BAY_API_KEY=

# Forecast push ingest (e.g. local FuXi-CFD Palma run → POST /api/forecasts/push).
# Set a long random secret; the pushing client sends it as the X-Ingest-Token
# header. Leave unset to disable the endpoint.
INGEST_TOKEN=

# KNMI
KNMI_API_KEY=
KNMI_API_BASE_URL=https://api.dataplatform.knmi.nl/open-data/v1
KNMI_DATASET_NAME=10-minute-in-situ-meteorological-observations
KNMI_DATASET_VERSION=1.0

# Meteo-France
METEOFRANCE_OBSERVATION_URL=
METEOFRANCE_API_KEY=

# NOAA / NCEI ISD
NCEI_API_BASE_URL=https://www.ncei.noaa.gov/access/services/data/v1
NCEI_DATASET=global-hourly
NCEI_TOKEN=

# Forecast source (Open-Meteo)
OPENMETEO_API_BASE_URL=https://api.open-meteo.com/v1/forecast
OPENMETEO_MODEL_HARMONIE=knmi_harmonie_arome_netherlands
OPENMETEO_MODEL_AROME=meteofrance_arome_france_hd
OPENMETEO_MODEL_ICON=icon_eu
OPENMETEO_MODEL_ECMWF=ecmwf_ifs04
